# Scribe Environment Configuration
# Copy this file to .env and fill in the values

# Database
DB_PASSWORD=scribe_dev

# Anthropic API Key (required for LLM features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth (Docs/Slides import/export)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# OIDC / Authentik SSO (optional — set OIDC_ENABLED=true to activate)
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.illanes00.cl/application/o/scribe/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://scribe.illanes00.cl/auth/callback
SECRET_KEY=change-me-in-production

# Environment
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
