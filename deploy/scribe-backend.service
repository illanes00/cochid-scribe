[Unit]
Description=Scribe API - FastAPI Backend
After=network.target

[Service]
Type=simple
User=illanes00
Group=illanes00
WorkingDirectory=/srv/projects/illanes00-scribe/backend
EnvironmentFile=/srv/projects/illanes00-scribe/.env

ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8132

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
